# ── LLM ──────────────────────────────────────────────────────────────────────
# Choose any model. The examples use init_chat_model() so any provider works.
#
# OpenAI:     gpt-4o-mini, gpt-4o
# Anthropic:  claude-haiku-4-5-20251001, claude-sonnet-4-6
# Ollama:     ollama:qwen2.5:3b  (free, runs locally — no API key needed)
# Groq:       groq:llama-3.1-8b-instant  (free tier)
SENTINEL_MODEL=gpt-4o-mini

# OpenAI (skip if using Anthropic / Ollama / Groq)
OPENAI_API_KEY=sk-...

# Anthropic (skip if using OpenAI / Ollama / Groq)
# ANTHROPIC_API_KEY=sk-ant-...

# Groq (skip if using OpenAI / Anthropic / Ollama)
# GROQ_API_KEY=gsk-...


# ── Observability backend — choose ONE ───────────────────────────────────────
# Set to "langfuse" (default) or "langsmith".
SENTINEL_BACKEND=langfuse


# ── Langfuse ──────────────────────────────────────────────────────────────────
# Self-hosted (recommended for local testing):
#   cd /path/to/langfuse && docker compose up
#   → UI at http://localhost:3000  (create a project → copy keys below)
#
# Cloud: https://cloud.langfuse.com  (free tier available)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...


# ── LangSmith ─────────────────────────────────────────────────────────────────
# Set SENTINEL_BACKEND=langsmith to activate this section.
# 1. Sign up at https://smith.langchain.com
# 2. Create an API key under Settings → API Keys
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=sentinel-examples


# ── [future] Arize ────────────────────────────────────────────────────────────
# ARIZE_API_KEY=...
# ARIZE_SPACE_KEY=...
