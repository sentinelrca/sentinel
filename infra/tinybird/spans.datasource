SCHEMA >
    `trace_id`        String `json:$.trace_id`,
    `span_id`         String `json:$.span_id`,
    `parent_span_id`  String `json:$.parent_span_id`,
    `workspace_id`    String `json:$.workspace_id`,
    `name`            String `json:$.name`,
    `kind`            String `json:$.kind`,
    `status`          String `json:$.status`,
    `start_time`      DateTime `json:$.start_time`,
    `end_time`        DateTime `json:$.end_time`,
    `model`           String `json:$.model`,
    `agent_name`      String `json:$.agent_name`,
    `input_tokens`    Int64 `json:$.input_tokens`,
    `output_tokens`   Int64 `json:$.output_tokens`,
    `retry_count`     Int32 `json:$.retry_count`,
    `error_message`   String `json:$.error_message`,
    `attributes_json` String `json:$.attributes_json`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(start_time)"
ENGINE_SORTING_KEY "workspace_id, start_time, trace_id"
