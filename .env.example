# Copy to .env and fill in values
# Never commit .env

DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
CLICKHOUSE_URL=clickhouse://localhost:9000/sentinel
REDIS_URL=redis://localhost:6379/0
SENTINEL_ENV=development

# API key for ingestion endpoint (generate with: openssl rand -hex 32)
SENTINEL_API_KEY=

# Langfuse (connector config — used by CLI and worker)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
